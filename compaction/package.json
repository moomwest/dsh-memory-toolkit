{
  "name": "dsh-agent-compaction",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "给 DSH 内置的兜底压缩装上「门牌」：自动摘要前插入可回溯的指针，让兜底产出的 checkpoint 也能按记忆架构回取原文",
  "main": "index.js",
  "files": [
    "HOW-TO-TAKEOVER.md",
    "README.md",
    "cordis.patch.yml",
    "index.js",
    "preset-probe.js",
    "tools/preset-takeover.mjs",
    "package.json",
    "lib"
  ],
  "exports": {
    ".": "./index.js",
    "./preset-probe": "./preset-probe.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-compaction": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "dsh-agent-organs contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moomwest/dsh-memory-toolkit.git",
    "directory": "compaction"
  },
  "homepage": "https://github.com/moomwest/dsh-memory-toolkit/tree/main/compaction#readme",
  "bugs": {
    "url": "https://github.com/moomwest/dsh-memory-toolkit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "compaction",
    "context-window",
    "checkpoint",
    "memory",
    "llm",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    }
  }
}
